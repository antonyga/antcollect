# Copia este archivo a .env y rellena los valores. .env NUNCA se sube a git.

# Clave de la API de Anthropic (necesaria solo para la lectura por IA).
ANTHROPIC_API_KEY=

# Modelo de visión a usar. Confirmar el id vigente en https://docs.claude.com.
ANTCOLLECT_MODELO=claude-sonnet-5

# Opcionales (valores por defecto entre paréntesis).
# ANTCOLLECT_DB=antcollect.db
# ANTCOLLECT_IMAGENES=imagenes
# ANTCOLLECT_RESIZE_LADO_LARGO=1568
# ANTCOLLECT_PUERTO=7860
