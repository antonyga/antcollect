# Copia este archivo a .env y rellena los valores. .env NUNCA se sube a git.

# Cadena de conexión async a PostgreSQL (Railway la da al aprovisionar la BD).
DATABASE_URL=postgresql+asyncpg://usuario:contrasena@localhost:5432/antcollect

# Secreto para firmar los JWT — genera uno largo y aleatorio, no uses este valor.
JWT_SECRET=cambia-esto-por-un-secreto-aleatorio-largo
JWT_ALGORITMO=HS256
JWT_ACCESO_MINUTOS=30
JWT_REFRESCO_DIAS=30

# CORS: solo para desarrollar la app Flutter en el navegador (flutter run -d
# chrome --web-port 5000). Vacío = desactivado (la app nativa no lo necesita).
# Ejemplo: CORS_ORIGENES=http://localhost:5000
CORS_ORIGENES=

# Política de privacidad, términos y página de borrado de cuenta (/privacidad,
# /terminos, /borrar-cuenta). Obligatorio antes de publicar: quién presta el
# servicio y un email de contacto que se publica en esas páginas.
# Sin configurar, las páginas lo dicen a la vista.
# LEGAL_RESPONSABLE=Nombre y apellidos (o razón social)
# LEGAL_CONTACTO=privacidad@tu-dominio.com

# Clave de la API de Anthropic, para POST /lecturas. Vive SOLO en el backend,
# nunca en la app móvil (RNF-5). Vacía = lectura IA desactivada (503, la app
# pasa al modo manual).
ANTHROPIC_API_KEY=
ANTCOLLECT_MODELO=claude-sonnet-5

# Respaldo si Claude falla (sin red, timeout, sobrecarga, error de la API...):
# se prueba al momento OpenAI y después DeepSeek, en la misma petición, para
# que el usuario no vea un error. Clave vacía = ese respaldo no se usa.
# (También se aceptan los nombres OPEN_AI_API_KEY / DEEPSEE_API_KEY.)
OPENAI_API_KEY=
ANTCOLLECT_MODELO_OPENAI=gpt-6.1-sol
DEEPSEEK_API_KEY=
ANTCOLLECT_MODELO_DEEPSEEK=deepseek-flash
# Por proveedor: timeout en segundos y reintentos del SDK (0 = pasar al
# siguiente proveedor al momento).
IA_TIMEOUT_SEGUNDOS=45
IA_REINTENTOS=0

# Cuota diaria de lecturas IA por usuario (RF-M3, coste de un servicio público).
LECTURAS_IA_CUOTA_DIARIA=20

# Imágenes: lado largo máximo al almacenar / al enviar a la IA, y tamaño
# máximo de subida en bytes (15 MB).
RESIZE_ALMACENAMIENTO=2000
RESIZE_LADO_LARGO=1568
IMAGEN_MAX_BYTES=15728640

# Almacén de imágenes: "local" (carpeta en disco, solo desarrollo) o "s3"
# (object storage compatible con S3 — Railway Buckets en producción).
ALMACEN=local
ALMACEN_DIR_LOCAL=./almacen_dev
# Solo con ALMACEN=s3 (credenciales del bucket; en Railway, referenciar las
# variables del servicio bucket en vez de copiarlas a mano):
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
